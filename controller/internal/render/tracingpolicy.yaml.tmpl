{{- /*
controller/internal/render/tracingpolicy.yaml.tmpl

Go text/template rendered by the controller, one per workload.

Template data:
  .Name       workload name, e.g. "checkout"
  .Namespace  workload namespace
  .UID        owner UID (for ownerReferences / cleanup)
  .OwnerKind  e.g. "Deployment"
  .OwnerAPI   e.g. "apps/v1"
  .Selector   map[string]string, the workload's pod selector labels
  .Binaries   []string, parsed from exec-allowlist.io/binaries
  .Enforce    bool, true when the namespace label is mode=enforce
  .RuntimeBinaries []string, node OCI runtime paths whose execs are exempt

How it works: security_bprm_check runs for every execve. Its first argument
(struct linux_binprm) carries the path of the binary about to run. If that
path matches none of the allowlisted values, the selector fires. In enforce
mode the process gets SIGKILL; in audit mode it only emits an event.

NotEqual with several values is "not in the set" (values are ANDed), per
Tetragon's selector docs. linux_binprm yields the resolved full path of
bprm->file, so symlinked paths never match (see README limitations).

Requires Tetragon with the policy filter enabled so podSelector works
(see deploy/tetragon-values.yaml). Exercised end to end on Tetragon 1.7.1 by
the e2e job in .github/workflows/ci.yaml.
*/ -}}
apiVersion: cilium.io/v1alpha1
kind: TracingPolicyNamespaced
metadata:
  name: exec-allowlist-{{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: exec-allowlist
    exec-allowlist.io/mode: {{ if .Enforce }}enforce{{ else }}audit{{ end }}
  ownerReferences:
    - apiVersion: {{ .OwnerAPI }}
      kind: {{ .OwnerKind }}
      name: {{ .Name }}
      uid: {{ .UID }}
spec:
  podSelector:
    matchLabels:
{{- range $k, $v := .Selector }}
      {{ $k }}: {{ $v | printf "%q" }}
{{- end }}
  kprobes:
    - call: security_bprm_check
      syscall: false
      args:
        - index: 0
          type: linux_binprm
{{- /*
  The OCI runtime re-execs itself (runc init) inside the pod's cgroup before
  it starts a container or `kubectl exec` process, and Tetragon then records
  runc init's binary as the runtime too. So:

  - selector 1 polices every exec except the allowlist and the runtime binary;
  - selector 2 polices exec *of* the runtime binary unless the caller is the
    runtime itself.

  Net effect: only runtime -> runtime re-execs are exempt. Without this,
  enforce mode breaks every exec into the pod ("write init-p: broken pipe").
  Selectors are a short-circuit OR; the first one that matches acts.
*/}}
      selectors:
        - matchArgs:
            - index: 0
              operator: NotEqual
              values:
{{- range .Binaries }}
                - {{ . | printf "%q" }}
{{- end }}
{{- range .RuntimeBinaries }}
                - {{ . | printf "%q" }}
{{- end }}
          matchActions:
            - action: {{ template "action" . }}
        - matchArgs:
            - index: 0
              operator: Equal
              values:
{{- range .RuntimeBinaries }}
                - {{ . | printf "%q" }}
{{- end }}
          matchBinaries:
            - operator: NotIn
              values:
{{- range .RuntimeBinaries }}
                - {{ . | printf "%q" }}
{{- end }}
          matchActions:
            - action: {{ template "action" . }}
{{- define "action" }}{{ if .Enforce }}Sigkill{{ else }}Post{{ end }}{{ end }}
